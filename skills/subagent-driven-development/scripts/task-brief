#!/usr/bin/env python3
"""Extract one Markdown Task heading and its body, ignoring fenced examples."""

import argparse
from pathlib import Path
import re
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("plan", type=Path)
    parser.add_argument("task", type=int)
    parser.add_argument("output", nargs="?", type=Path)
    args = parser.parse_args()
    if args.task < 1:
        parser.error("task must be a positive integer")
    if not args.plan.is_file():
        parser.error(f"no such plan file: {args.plan}")

    selected = []
    in_task = False
    fence = None
    for line in args.plan.read_text(encoding="utf-8-sig").splitlines(keepends=True):
        marker = re.match(r"^\s{0,3}(`{3,}|~{3,})", line)
        if marker:
            delimiter = marker.group(1)
            if fence is None:
                fence = delimiter
            elif delimiter[0] == fence[0] and len(delimiter) >= len(fence):
                fence = None
        elif fence is None:
            heading = re.match(r"^#{1,6}\s+Task\s+(\d+)(?:\D|$)", line)
            if heading:
                in_task = int(heading.group(1)) == args.task
        if in_task:
            selected.append(line)
    if not selected:
        print(f"task {args.task} not found in {args.plan}", file=sys.stderr)
        return 3

    output = args.output
    if output is None:
        result = subprocess.run(
            [sys.executable, str(Path(__file__).with_name("sdd-workspace"))],
            capture_output=True, text=True, encoding="utf-8", errors="replace",
        )
        if result.returncode:
            print(result.stderr.strip(), file=sys.stderr)
            return result.returncode
        output = Path(result.stdout.strip()) / f"task-{args.task}-brief.md"
    output.parent.mkdir(parents=True, exist_ok=True)
    with output.open("w", encoding="utf-8", newline="\n") as stream:
        stream.write("".join(selected))
    print(f"wrote {output}: {len(selected)} lines")
    return 0


if __name__ == "__main__":
    import sys
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stderr.reconfigure(encoding="utf-8")
    raise SystemExit(main())
