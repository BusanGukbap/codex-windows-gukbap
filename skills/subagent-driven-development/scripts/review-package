#!/usr/bin/env python3
"""Write a review package for an existing Git commit range (no commits made)."""

import argparse
from pathlib import Path
import subprocess
import sys


def git(*args):
    return subprocess.check_output(
        ["git", "--no-pager", *args], text=True, encoding="utf-8", errors="replace",
        stderr=subprocess.PIPE,
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("base")
    parser.add_argument("head")
    parser.add_argument("output", nargs="?", type=Path)
    args = parser.parse_args()
    try:
        base = git("rev-parse", "--verify", "--end-of-options", args.base + "^{commit}").strip()
        head = git("rev-parse", "--verify", "--end-of-options", args.head + "^{commit}").strip()
        revision_range = f"{base}..{head}"
        sections = [
            f"# Review package: {args.base}..{args.head}\n\n## Commits\n",
            git("log", "--oneline", revision_range),
            "\n## Files changed\n", git("diff", "--stat", revision_range),
            "\n## Diff\n", git("diff", "-U10", revision_range),
        ]
        count = git("rev-list", "--count", revision_range).strip()
        output = args.output
        if output is None:
            result = subprocess.run(
                [sys.executable, str(Path(__file__).with_name("sdd-workspace"))],
                capture_output=True, text=True, encoding="utf-8", errors="replace",
                check=True,
            )
            output = Path(result.stdout.strip()) / f"review-{base[:7]}..{head[:7]}.diff"
        output.parent.mkdir(parents=True, exist_ok=True)
        content = "".join(sections)
        with output.open("w", encoding="utf-8", newline="\n") as stream:
            stream.write(content)
        print(f"wrote {output}: {count} commit(s), {len(content.encode('utf-8'))} bytes")
        return 0
    except subprocess.CalledProcessError as error:
        print((error.stderr or "invalid Git revision or repository").strip(), file=sys.stderr)
        return 2


if __name__ == "__main__":
    import sys
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stderr.reconfigure(encoding="utf-8")
    raise SystemExit(main())
